{
  "name": "fastfileocr",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "tauri": "tauri",
    "resources:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/resources.ps1 && node scripts/build/prepare-nsis.mjs",
    "resources:check": "node scripts/build/check-resources.mjs",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/installer.ps1",
    "test": "npm run test:ui && npm run test:tools && npm run test:rust && npm run test:installer-helper",
    "check": "npm run format:check && npm run locales:check && npm run versions:check && npm run build && npm test",
    "format": "prettier --write src locate scripts/**/*.mjs README*.md docs/**/*.md",
    "locales:check": "node scripts/dev/check-locales.mjs",
    "installer:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/test-installer-data.ps1",
    "test:ui": "node --experimental-strip-types --test src/domain/*.test.ts",
    "test:tools": "node --test scripts/build/*.test.mjs",
    "test:rust": "node scripts/dev/test-rust.mjs",
    "test:installer-helper": "cargo test --locked --manifest-path installer/helper/Cargo.toml --target-dir .cache/installer-helper-target",
    "test:resources": "cargo test --locked --manifest-path src-tauri/Cargo.toml import::tests::imports_more_than_one_pdf_in_the_same_process -- --ignored --exact",
    "format:check": "prettier --check src locate scripts/**/*.mjs README*.md docs/**/*.md CONTRIBUTING.md package.json && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path installer/helper/Cargo.toml -- --check",
    "versions:check": "node scripts/dev/check-versions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "description": "Simple / Fast / Accurate — Rust OCR powered by PaddleOCR-VL 1.6",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinhyeonseo01/FastFileOCR.git"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
