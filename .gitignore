*.gguf
*.safetensors
*.onnx
*.part

# Local workspaces, test output and build caches
/.cache/
/workspace/
/work/
/outputs/
/output/
/.playwright-cli/
/.openai/

# Local environment, credentials and signing materials
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# Logs and OS metadata
*.log
*.tmp
.DS_Store
Thumbs.db
Desktop.ini
