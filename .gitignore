# Dependencies and generated frontend output
/node_modules/
/dist/
*.tsbuildinfo

# Native build outputs and prepared third-party assets
/src-tauri/target/
/src-tauri/gen/
/src-tauri/resources/runtime/
/src-tauri/resources/layout/
/src-tauri/resources/licenses/
/src-tauri/resources/bundle-manifest.json

