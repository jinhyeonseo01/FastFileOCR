{
  "name": "fastfileocr",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "tauri": "tauri",
    "resources:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/resources.ps1 && node scripts/build/prepare-nsis.mjs",
    "resources:check": "node scripts/build/check-resources.mjs",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/installer.ps1",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src locate scripts/**/*.mjs README*.md docs/**/*.md",
    "locales:check": "node scripts/dev/check-locales.mjs",
    "installer:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/test-installer-data.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "description": "Simple / Fast / Accurate — Rust OCR powered by PaddleOCR-VL 1.6",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinhyeonseo01/FastFileOCR.git"
  }
}
